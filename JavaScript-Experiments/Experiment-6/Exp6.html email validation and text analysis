<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Text Processing Tool - Email, Data & Analysis</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #f5f7fa;
        height: 100vh;
        padding: 0.75rem;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #2c3e50;
        line-height: 1.6;
        overflow: hidden;
      }

      .container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        max-width: 1200px;
        width: 100%;
        padding: 1.5rem 1.75rem;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        border: 1px solid #e8ecf1;
      }

      /* Typography */
      h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.6px;
        color: #1a1f36;
        margin-bottom: 0.25rem;
        text-align: center;
        line-height: 1.2;
        flex-shrink: 0;
      }

      h3 {
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: 0.4px;
        color: #34495e;
      }

      .heading {
        text-align: center;
        color: #3498db;
        font-weight: 500;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
        letter-spacing: 0.4px;
        flex-shrink: 0;
      }

      .subtitle {
        text-align: center;
        color: #7f8c8d;
        margin-bottom: 1rem;
        font-size: 0.875rem;
        font-weight: 400;
        letter-spacing: 0.3px;
        flex-shrink: 0;
      }

      .input-section {
        margin-bottom: 1rem;
        flex-shrink: 0;
      }

      label {
        display: block;
        margin-bottom: 0.5rem;
        color: #2c3e50;
        font-weight: 500;
        font-size: 0.875rem;
        letter-spacing: 0.2px;
      }

      textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #d5dbdb;
        border-radius: 8px;
        font-family: "SF Mono", "Monaco", "Menlo", monospace;
        font-size: 0.875rem;
        resize: none;
        height: 80px;
        transition: all 0.2s ease;
        line-height: 1.5;
        color: #2c3e50;
        background: #fafbfc;
      }

      textarea::placeholder {
        color: #a8abb2;
        font-size: 0.875rem;
      }

      textarea:focus {
        outline: none;
        border-color: #3498db;
        background: white;
        box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.08);
      }

      .button-group {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
      }

      button {
        flex: 1;
        min-width: 120px;
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.3px;
        cursor: pointer;
        transition: all 0.2s ease;
        line-height: 1.3;
      }

      .btn-primary {
        background: #3498db;
        color: white;
      }

      .btn-primary:hover {
        background: #2980b9;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.2);
      }

      .btn-secondary {
        background: #ecf0f1;
        color: #2c3e50;
        border: 1px solid #d5dbdb;
      }

      .btn-secondary:hover {
        background: #d5dbdb;
      }

      .results-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 0.75rem;
        flex: 1;
        overflow-y: auto;
      }

      .result-card {
        background: #fafbfc;
        border: 1px solid #e8ecf1;
        border-radius: 10px;
        padding: 1rem;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        min-height: 0;
      }

      .result-card:hover {
        border-color: #3498db;
        background: #f9fbfd;
        box-shadow: 0 2px 8px rgba(52, 152, 219, 0.1);
      }

      .result-card h3 {
        color: #2c3e50;
        font-size: 0.75rem;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        font-weight: 600;
        flex-shrink: 0;
      }

      .result-content {
        background: white;
        padding: 0.75rem;
        border-radius: 8px;
        min-height: 40px;
        word-break: break-word;
        color: #2c3e50;
        font-size: 0.8125rem;
        line-height: 1.5;
        flex-grow: 1;
        overflow-y: auto;
        border: 1px solid #ecf0f1;
      }

      .result-content div {
        margin-bottom: 0.5rem;
        line-height: 1.6;
      }

      .result-content strong {
        font-weight: 600;
        color: #1a1f36;
      }

      .result-content.empty {
        color: #7f8c8d;
        font-style: italic;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .status-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.3px;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }

      .badge-valid {
        background: #d4edda;
        color: #155724;
      }

      .badge-invalid {
        background: #f8d7da;
        color: #721c24;
      }

      .stat-box {
        background: white;
        padding: 0.75rem;
        border-radius: 8px;
        text-align: center;
        border-left: 3px solid #3498db;
        transition: all 0.2s ease;
        border: 1px solid #ecf0f1;
        border-left: 3px solid #3498db;
      }

      .stat-box:hover {
        box-shadow: 0 2px 6px rgba(52, 152, 219, 0.1);
      }

      .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #3498db;
        letter-spacing: -0.5px;
        line-height: 1.2;
      }

      .stat-label {
        font-size: 0.7rem;
        color: #7f8c8d;
        margin-top: 0.25rem;
        font-weight: 500;
        letter-spacing: 0.2px;
        text-transform: uppercase;
      }

      .copy-btn {
        background: #3498db;
        color: white;
        border: none;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.2px;
        cursor: pointer;
        margin-top: 0.75rem;
        transition: all 0.2s ease;
        line-height: 1.3;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        background: #2980b9;
        box-shadow: 0 2px 8px rgba(52, 152, 219, 0.2);
      }

      #searchKeyword {
        font-size: 0.9375rem;
        font-family: inherit;
        letter-spacing: 0.2px;
      }

      /* Scrollbar styling */
      .result-content::-webkit-scrollbar {
        width: 6px;
      }

      .result-content::-webkit-scrollbar-track {
        background: #f0f0f0;
        border-radius: 10px;
      }

      .result-content::-webkit-scrollbar-thumb {
        background: #d0d0d0;
        border-radius: 10px;
      }

      .result-content::-webkit-scrollbar-thumb:hover {
        background: #b0b0b0;
      }

      @media (max-width: 768px) {
        html {
          font-size: 14px;
        }

        .container {
          padding: 1rem 1rem;
          border-radius: 12px;
          max-height: none;
        }

        h1 {
          font-size: 1.75rem;
          margin-bottom: 0.25rem;
        }

        .subtitle {
          font-size: 0.875rem;
          margin-bottom: 1rem;
        }

        .results-section {
          grid-template-columns: repeat(2, 1fr);
          gap: 0.75rem;
        }

        .button-group {
          flex-direction: row;
        }

        button {
          min-width: auto;
        }

        .stat-number {
          font-size: 1.25rem;
        }
      }

      @media (max-width: 480px) {
        html {
          font-size: 12px;
        }

        .container {
          padding: 0.75rem 0.5rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .subtitle {
          font-size: 0.75rem;
          margin-bottom: 0.75rem;
        }

        .results-section {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }

        .stat-number {
          font-size: 1.125rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Text Processing Tool</h1>
      <p class="heading">Welcome Sanvi Wadhankar [24070521191]</p>
      <p class="subtitle">Email Validation, Data Extraction & Text Analysis</p>

      <div class="input-section">
        <label for="textInput">Input Text</label>
        <textarea
          id="textInput"
          placeholder="Enter your text here. Example: Contact us at admin@example.com or support@gmail.com. Welcome to our website!"
        ></textarea>
        <div class="button-group">
          <button class="btn-primary" onclick="processAll()">
            Analyze Text
          </button>
          <button class="btn-secondary" onclick="clearAll()">Clear</button>
        </div>
      </div>

      <div class="results-section">
        <!-- Email Validation -->
        <div class="result-card">
          <h3>Email Validation</h3>
          <div class="result-content" id="emailValidation">
            Enter text to validate emails
          </div>
          <button class="copy-btn" onclick="copyToClipboard('emailValidation')">
            Copy
          </button>
        </div>

        <!-- Data Extraction -->
        <div class="result-card">
          <h3>Extracted Emails</h3>
          <div class="result-content" id="extractedEmails">No emails found</div>
          <button class="copy-btn" onclick="copyToClipboard('extractedEmails')">
            Copy
          </button>
        </div>

        <!-- String Functions -->
        <div class="result-card">
          <h3>String Transformations</h3>
          <div class="result-content" id="stringFunctions">
            <div><strong>Uppercase:</strong> <span id="uppercase">-</span></div>
            <div><strong>Lowercase:</strong> <span id="lowercase">-</span></div>
          </div>
          <button class="copy-btn" onclick="copyToClipboard('stringFunctions')">
            Copy
          </button>
        </div>

        <!-- Text Analysis -->
        <div class="result-card">
          <h3>Text Analysis</h3>
          <div class="stats-grid">
            <div class="stat-box">
              <div class="stat-number" id="wordCount">0</div>
              <div class="stat-label">Words</div>
            </div>
            <div class="stat-box">
              <div class="stat-number" id="charCount">0</div>
              <div class="stat-label">Characters</div>
            </div>
          </div>
        </div>

        <!-- Keyword Search -->
        <div class="result-card">
          <h3>Keyword Search</h3>
          <input
            type="text"
            id="searchKeyword"
            placeholder="Enter keyword..."
            style="
              width: 100%;
              padding: 0.625rem;
              border: 1px solid #d5dbdb;
              border-radius: 8px;
              margin-bottom: 0.75rem;
              font-size: 0.875rem;
            "
          />
          <div class="result-content" id="searchResult">
            Enter a keyword above
          </div>
          <button
            class="btn-secondary"
            style="width: 100%; margin-top: 0.75rem; padding: 0.625rem"
            onclick="searchKeyword()"
          >
            Search
          </button>
        </div>

        <!-- Sentence Analysis -->
        <div class="result-card">
          <h3>Sentence Analysis</h3>
          <div class="stats-grid">
            <div class="stat-box">
              <div class="stat-number" id="sentenceCount">0</div>
              <div class="stat-label">Sentences</div>
            </div>
            <div class="stat-box">
              <div class="stat-number" id="avgWordLength">0</div>
              <div class="stat-label">Avg Length</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Email Regex Pattern
      const emailRegex = /[^\s@]+@[^\s@]+\.[^\s@]+/g;
      const emailValidationRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function processAll() {
        const text = document.getElementById("textInput").value;
        if (!text.trim()) {
          alert("Please enter some text to process");
          return;
        }

        // 1. Email Validation
        validateEmail(text);

        // 2. Extract Emails
        extractEmails(text);

        // 3. String Functions
        stringTransformations(text);

        // 4. Text Analysis
        analyzeText(text);
      }

      function validateEmail(text) {
        const lines = text.split("\n");
        let validationResults = "";

        lines.forEach((line, index) => {
          const trimmed = line.trim();
          if (trimmed && emailValidationRegex.test(trimmed)) {
            validationResults += `<span class="status-badge badge-valid">✓ Valid</span>`;
          } else if (trimmed && trimmed.includes("@")) {
            validationResults += `<span class="status-badge badge-invalid">✗ Invalid</span>`;
          }
        });

        const emailsInText = text.match(emailRegex);
        if (emailsInText && emailsInText.length > 0) {
          validationResults += `<br><strong>Found: ${emailsInText.length} email(s)</strong><br>`;
          emailsInText.forEach((email) => {
            const isValid = emailValidationRegex.test(email);
            validationResults += `<div style="margin-top: 5px;">${email} <span class="status-badge ${isValid ? "badge-valid" : "badge-invalid"}">${isValid ? "✓ Valid" : "✗ Invalid"}</span></div>`;
          });
        } else {
          validationResults =
            '<span class="empty">No emails found in text</span>';
        }

        document.getElementById("emailValidation").innerHTML =
          validationResults;
      }

      function extractEmails(text) {
        const emails = text.match(emailRegex);
        const resultDiv = document.getElementById("extractedEmails");

        if (emails && emails.length > 0) {
          const uniqueEmails = [...new Set(emails)];
          resultDiv.innerHTML = `<strong>Found ${emails.length} email(s):</strong><br>${emails.join("<br>")}`;
        } else {
          resultDiv.innerHTML = '<span class="empty">No emails found</span>';
        }
      }

      function stringTransformations(text) {
        const uppercase = text.toUpperCase();
        const lowercase = text.toLowerCase();

        document.getElementById("uppercase").textContent =
          uppercase.substring(0, 50) + (uppercase.length > 50 ? "..." : "");
        document.getElementById("lowercase").textContent =
          lowercase.substring(0, 50) + (lowercase.length > 50 ? "..." : "");

        // Show full text on hover
        document.getElementById("uppercase").title = uppercase;
        document.getElementById("lowercase").title = lowercase;
      }

      function analyzeText(text) {
        // Word Count
        const words = text
          .trim()
          .split(/\s+/)
          .filter((word) => word.length > 0);
        document.getElementById("wordCount").textContent = words.length;

        // Character Count
        document.getElementById("charCount").textContent = text.length;

        // Sentence Count
        const sentences = text
          .split(/[.!?]+/)
          .filter((s) => s.trim().length > 0);
        document.getElementById("sentenceCount").textContent = sentences.length;

        // Average Word Length
        const avgLength =
          words.length > 0
            ? (text.replace(/\s/g, "").length / words.length).toFixed(1)
            : 0;
        document.getElementById("avgWordLength").textContent = avgLength;
      }

      function searchKeyword() {
        const text = document.getElementById("textInput").value;
        const keyword = document.getElementById("searchKeyword").value.trim();
        const resultDiv = document.getElementById("searchResult");

        if (!keyword) {
          resultDiv.innerHTML =
            '<span class="empty">Enter a keyword to search</span>';
          return;
        }

        if (!text.trim()) {
          resultDiv.innerHTML =
            '<span class="empty">No text to search in</span>';
          return;
        }

        // Create regex for keyword search (case-insensitive)
        const searchRegex = new RegExp(keyword, "gi");
        const matches = text.match(searchRegex);

        if (matches && matches.length > 0) {
          const containsKeyword = text
            .toLowerCase()
            .includes(keyword.toLowerCase());
          resultDiv.innerHTML = `
                    <div><strong>Keyword:</strong> "${keyword}"</div>
                    <div><strong>Occurrences:</strong> ${matches.length}</div>
                    <div><strong>Contains:</strong> ${containsKeyword ? '<span class="badge-valid" style="padding: 4px 8px; border-radius: 4px; background: #d4edda; color: #155724;">Yes ✓</span>' : '<span class="badge-invalid" style="padding: 4px 8px; border-radius: 4px; background: #f8d7da; color: #721c24;">No ✗</span>'}</div>
                `;
        } else {
          resultDiv.innerHTML = `<div><strong>Keyword:</strong> "${keyword}"</div><div class="empty" style="margin-top: 5px;">Not found in text</div>`;
        }
      }

      function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        const text = element.innerText;
        navigator.clipboard.writeText(text).then(() => {
          alert("Copied to clipboard!");
        });
      }

      function clearAll() {
        document.getElementById("textInput").value = "";
        document.getElementById("emailValidation").innerHTML =
          "Enter text to validate emails";
        document.getElementById("extractedEmails").innerHTML =
          "No emails found";
        document.getElementById("uppercase").textContent = "-";
        document.getElementById("lowercase").textContent = "-";
        document.getElementById("wordCount").textContent = "0";
        document.getElementById("charCount").textContent = "0";
        document.getElementById("sentenceCount").textContent = "0";
        document.getElementById("avgWordLength").textContent = "0";
        document.getElementById("searchKeyword").value = "";
        document.getElementById("searchResult").innerHTML =
          "Enter a keyword above";
      }

      // Allow Enter key to process
      document.getElementById("textInput").addEventListener("keydown", (e) => {
        if (e.ctrlKey && e.key === "Enter") {
          processAll();
        }
      });

      // Real-time search as you type
      document
        .getElementById("searchKeyword")
        .addEventListener("keyup", searchKeyword);
    </script>
  </body>
</html>
